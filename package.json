{
  "name": "dbml-converter",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:deployment-tags": "node --test scripts/inject-google-tags.test.mjs",
    "inject-deployment-tags": "node scripts/inject-google-tags.mjs",
    "github-build": "ng build --configuration production --base-href /dbml-converter/ && npm run inject-deployment-tags",
    "github-deploy": "npx angular-cli-ghpages --dir=dist/dbml-converter/browser --no-silent"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@tailwindcss/postcss": "^4.1.13",
    "elkjs": "0.11.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.3.1",
    "@types/prismjs": "^1.26.5",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
