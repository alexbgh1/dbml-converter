Table employees {
  id bigint [pk]
  manager_id bigint [ref: > employees.id]
  mentor_id bigint [ref: > employees.id]
  delegate_id bigint [ref: > employees.id]
}

Table cycle_alpha {
  id bigint [pk]
  beta_id bigint [not null, ref: > cycle_beta.id]
}

Table cycle_beta {
  id bigint [pk]
  gamma_id bigint [not null, ref: > cycle_gamma.id]
}

Table cycle_gamma {
  id bigint [pk]
  alpha_id bigint [not null, ref: > cycle_alpha.id]
}
