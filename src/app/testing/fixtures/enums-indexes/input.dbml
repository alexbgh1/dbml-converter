Enum order_status {
  pending
  approved
  cancelled
}

Table orders {
  id uuid
  tenant_id int [not null]
  status order_status [default: 'pending']
  reference varchar

  indexes {
    id [pk, name: 'pk_orders']
    reference [unique, name: 'uq_orders_reference']
    (tenant_id, status) [name: 'idx_orders_tenant_status']
  }
}
